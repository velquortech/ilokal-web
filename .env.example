# Environment template — NAMES AND COMMENTS ONLY. Never put a real value here;
# this is the one `.env*` file that is committed (see .gitignore).
#
# Rule: `NEXT_PUBLIC_` is inlined into the client bundle at BUILD time. Anything
# secret must not carry that prefix, and anything public must be present when
# the build runs, not merely at runtime.

# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_TOKEN=
# Server only. Bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Server only. Direct Postgres connection string.
SUPABASE_DB_URL=

# ── App ─────────────────────────────────────────────────────────────────────
# Must be set at BUILD time: it is inlined, and every share card and password
# reset link is built from it. Unset in production means share cards point at
# localhost and reset links fail closed.
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_DESTINATION=
NEXT_IMAGE_PUBLIC_URL=

# ── Transactional email (Resend) ────────────────────────────────────────────
# Server only. Anything that is not a real `re_…` key puts the reset link in the
# server log instead of sending it.
RESEND_API_KEY=
EMAIL_FROM=

# ── Rate limiting (optional, all have defaults) ─────────────────────────────
MOBILE_RATE_LIMIT=
MOBILE_RATE_WINDOW_MS=
MENU_REMINDER_COOLDOWN_HOURS=

# ── Sentry (see .claude/SENTRY_MONITORING.md) ───────────────────────────────
# Used by the node and edge runtimes. NOT NEXT_PUBLIC_ — the browser has its own
# DSN below, and crossing the two would inline the server DSN into every
# visitor's bundle. Unset ⇒ the SDK is disabled entirely and no event is queued
# (this is what keeps dev and CI silent).
SENTRY_DSN=
# OPTIONAL. Read by the SDK itself, not by our config. Unset, it resolves
# VERCEL_ENV then NODE_ENV on its own — so on Vercel, leave this blank and
# preview deploys stay distinguishable from production.
SENTRY_ENVIRONMENT=
# Defaults to 0.05. Free tier is 10k performance units/month.
SENTRY_TRACES_SAMPLE_RATE=
# The proxy runs on every matched navigation, so it needs its own lower rate.
# Defaults to 0.01.
SENTRY_EDGE_TRACES_SAMPLE_RATE=

# NOTE: there is deliberately no SENTRY_RELEASE / NEXT_PUBLIC_SENTRY_RELEASE.
# The release is INJECTED by the bundler at build time and is what the uploaded
# source maps are keyed to. Passing one would override it — see the note in
# sentry.server.config.ts.

# Browser. Inlined at BUILD time, and that is intended — the browser cannot read
# a server env var. Events go through the same-origin /monitoring tunnel, so no
# CSP change is needed; see the tunnel note in next.config.ts.
NEXT_PUBLIC_SENTRY_DSN=
# OPTIONAL. Unset, the SDK falls back to NEXT_PUBLIC_VERCEL_ENV — which needs
# Vercel's "Automatically expose System Environment Variables" enabled.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Defaults to 0.01 — browser traffic dwarfs server error volume.
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=

# Rate limit on the /monitoring tunnel (proxy.ts). It is an unauthenticated
# POST that forwards to Sentry, so it is a way to burn the event quota.
# Defaults: 60 requests / 60000 ms per IP.
SENTRY_TUNNEL_RATE_LIMIT=
SENTRY_TUNNEL_WINDOW_MS=

# BUILD TIME ONLY — source map upload. Missing means the build still SUCCEEDS
# and simply uploads nothing, so every production stack trace stays minified.
# That failure is silent; check for it after the first deploy.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
